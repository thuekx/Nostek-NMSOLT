# =====================================================================
# Nostek-NMSOLT — konfigurasi Docker (host-side).
# Salin file ini menjadi ".env" lalu ubah minimal DB_PASSWORD & admin:
#     cp .env.docker.example .env
# File ini dibaca oleh docker-compose (bukan .env Laravel di dalam container).
# =====================================================================

# Port di PC untuk membuka aplikasi → http://localhost:<APP_PORT>
APP_PORT=18080

APP_NAME="Nostek-NMSOLT"
APP_URL=http://localhost:18080

# Bila dibuka lewat HTTPS dari reverse proxy di luar container (nginx/Caddy di host,
# Cloudflare Tunnel, dll.), proxy itu menyambung dari jaringan Docker — percayai
# jaringannya supaya skema https & IP klien terbaca benar (kalau tidak: login 419).
# Contoh proxy di host: TRUSTED_PROXIES=172.16.0.0/12  ·  lalu SESSION_SECURE_COOKIE=true
# TRUSTED_PROXIES=
# SESSION_SECURE_COOKIE=

# Biarkan KOSONG → digenerate otomatis sekali & disimpan permanen di volume.
# (Isi hanya bila ingin memakai key dari instalasi lain, format base64:...)
APP_KEY=

# ---- Database (PostgreSQL, jalan di container "db") ----
DB_DATABASE=nostek_nmsolt
DB_USERNAME=nostek_nmsolt
DB_PASSWORD=

# ---- ACS / TR069 (isi sesuai server ACS Anda) ----
ACS_URL=http://acs.example.net:7547
ACS_USERNAME=
ACS_PASSWORD=

# ---- Akun admin awal (opsional) ----
# Diisi hanya dipakai saat instalasi PERTAMA (tabel users masih kosong).
# Kosongkan untuk membuat admin manual: docker compose exec app php artisan user:create
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional GenieACS lab overlay only (not launched by default)
# Set secret locally before using -f compose.acs.yaml, DO NOT commit .env
GENIEACS_UI_JWT_SECRET=
ACS_CWMP_PORT=17547
ACS_UI_PORT=13000
